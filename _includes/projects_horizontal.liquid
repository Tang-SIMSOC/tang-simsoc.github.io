<div class="col mb-4">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      <div class="row no-gutters">
        {% if project.img %}
          {% assign image_column = 'col-md-6' %}
          {% assign text_column = 'col-md-6' %}
          {% assign thumbnail_sizes = '(min-width: 768px) 156px, 50vw' %}
          {% if project.thumbnail_width == 'compact' %}
            {% assign image_column = 'col-md-4' %}
            {% assign text_column = 'col-md-8' %}
            {% assign thumbnail_sizes = '(min-width: 768px) 104px, 50vw' %}
          {% endif %}
          <div class="{{ image_column }}">
            {% include figure.liquid loading="eager" path=project.img sizes=thumbnail_sizes alt="project thumbnail" class="card-img" %}
          </div>
        {% endif %}
        <div class="{% if project.img %}{{ text_column }}{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title">{{ project.title }}</h3>
            <p class="card-text">{{ project.description }}</p>
            <div class="row ml-1 mr-1 p-0">
              {% if project.github %}
                <div class="github-icon">
                  <div class="icon" data-toggle="tooltip" title="Code Repository">
                    <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
                  </div>
                  {% if project.github_stars %}
                    <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                      <i class="fa-solid fa-star"></i>
                      <span id="{{ project.github_stars }}-stars"></span>
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
